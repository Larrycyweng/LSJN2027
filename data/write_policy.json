{
  "version": "1.0",
  "writer": "Claude 專案對話產生寫回包；使用者在 App 確認後由 App 寫入 repo。",
  "allowed_operations": [
    {
      "op": "add_session",
      "target": "sessions",
      "note": "新增學習紀錄"
    },
    {
      "op": "add_card",
      "target": "cards",
      "note": "新增知識卡片，狀態一律先為待確認"
    },
    {
      "op": "add_handoff",
      "target": "handoffs",
      "note": "新增課後接續摘要"
    },
    {
      "op": "add_signature",
      "target": "signatures",
      "note": "新增錯誤指紋，狀態為追蹤中"
    },
    {
      "op": "suggest_signature_update",
      "target": "signatures",
      "note": "只更新 stage、signature_status、evidence_count、last_seen"
    },
    {
      "op": "suggest_hypothesis_update",
      "target": "hypotheses",
      "note": "只更新 hypothesis_status、supporting_evidence、contrary_evidence、independent_observations、next_test、current_decision"
    },
    {
      "op": "add_attempt",
      "target": "attempts",
      "note": "新增作答。官方題必須附 source_evidence:'使用者截圖'，且只轉錄截圖可見內容，不明欄位留白。"
    },
    {
      "op": "update_exposure",
      "target": "exposure",
      "note": "更新官方題接觸狀態（依使用者回報或截圖）"
    },
    {
      "op": "mark_progress",
      "target": "progress",
      "note": "標記進度表項目完成（item_id 來自 settings.checklist）。"
    },
    {
      "op": "update_session",
      "target": "sessions",
      "note": "補充既有學習紀錄的內容欄位。"
    }
  ],
  "forbidden": [
    "刪除任何紀錄",
    "修改 settings.json 的計畫參數",
    "修改 checkpoints 的決定（決定由使用者在 App 作成）",
    "覆寫既有作答答案（同題重做須建新作答編號）",
    "虛構截圖上不可見的作答資料"
  ],
  "idempotency": "每筆項目必須有 client_request_id；App 拒絕已存在的 id。",
  "mastery_rule": "知識卡片複習按「記得」不改變 status；status 升級只能由新題驗證後的寫回包提出，且仍需使用者確認。"
}